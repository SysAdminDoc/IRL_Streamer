<?xml version="1.0" encoding="utf-8"?>
<!--
    The settings store holds the outgoing connection URL, and an RTMP URL carries
    the stream key in its path. Auto Backup includes getFilesDir() by default, so
    without this exclusion the key leaves the device with the backup.

    The whole datastore directory is excluded, not just the one file: DataStore
    writes a scratch file beside it and renames, so an exact-filename rule leaves
    a window where a copy of the key is not covered. The path must contain
    ReplicaSettingsRepository's store directory;
    BackupRulesTest keeps the two in step.
-->
<full-backup-content>
    <exclude domain="file" path="datastore" />
</full-backup-content>
